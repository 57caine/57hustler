---
import AffiliateButton from './AffiliateButton.astro';
import { getProgram } from '../lib/affiliates.ts';

interface Props {
  rank: number;
  programId: string;
  catchcopy: string;
  reason: string;
  recommendedFor?: string[];
  campaign: string;
}
const { rank, programId, catchcopy, reason, recommendedFor = [], campaign } = Astro.props;
const program = getProgram(programId);
const medal = ['bg-amber-400', 'bg-slate-400', 'bg-orange-700'][rank - 1] ?? 'bg-brand-600';
---
<article class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-200 md:p-7" id={`rank-${rank}`}>
  <div class="flex items-start gap-4">
    <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white', medal]}>{rank}</span>
    <div class="min-w-0">
      <p class="text-sm font-bold text-brand-600">{catchcopy}</p>
      <h3 class="text-xl font-bold text-brand-900 md:text-2xl">{program.name}</h3>
    </div>
  </div>

  {program.image ? (
    <img src={program.image} alt={program.name} width="600" height="315" loading="lazy" class="mt-4 w-full rounded-xl object-cover" />
  ) : null}

  {recommendedFor.length > 0 && (
    <div class="mt-4 rounded-xl bg-brand-50 p-4">
      <p class="mb-1 text-sm font-bold text-brand-900">こんな人におすすめ</p>
      <ul class="space-y-1 text-sm">
        {recommendedFor.map((r) => <li class="flex gap-2"><span aria-hidden="true" class="text-brand-600">✓</span>{r}</li>)}
      </ul>
    </div>
  )}

  <p class="mt-4">{reason}</p>

  {(program.highlights?.length ?? 0) > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {program.highlights!.map((h) => <li class="rounded-full bg-surface px-3 py-1 text-xs ring-1 ring-slate-200">{h}</li>)}
    </ul>
  )}

  {(program.cautions?.length ?? 0) > 0 && (
    <div class="mt-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-900">
      <p class="font-bold">注意点</p>
      <ul class="list-disc pl-5">{program.cautions!.map((c) => <li>{c}</li>)}</ul>
    </div>
  )}

  <div class="mt-5 text-center">
    <AffiliateButton programId={program.id} label={`${program.name}の公式サイトを見る`} placement={`ranking-${rank}`} campaign={campaign} />
  </div>
</article>
