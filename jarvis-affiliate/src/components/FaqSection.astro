---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
{items.length > 0 && (
  <section id="faq" class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="mb-4 text-2xl font-bold text-brand-900">よくある質問</h2>
    <div class="divide-y divide-slate-200 rounded-2xl ring-1 ring-slate-200">
      {items.map((item) => (
        <details class="group p-4 open:bg-surface">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 font-bold text-brand-900">
            <span><span class="mr-2 text-brand-600">Q.</span>{item.q}</span>
            <span aria-hidden="true" class="transition group-open:rotate-45">＋</span>
          </summary>
          <p class="mt-3"><span class="mr-2 font-bold text-cta-600">A.</span>{item.a}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </section>
)}
