---
/**
 * content/campaigns/*.md（status: published）から LP を自動生成する
 * URL: /lp/{slug}/
 */
import { marked } from 'marked';
import LpLayout from '../../layouts/LpLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import RankingCard from '../../components/RankingCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { loadCampaigns, type Campaign } from '../../lib/campaigns.ts';
import { getProgram } from '../../lib/affiliates.ts';

export function getStaticPaths() {
  return loadCampaigns().map((campaign) => ({ params: { slug: campaign.slug }, props: { campaign } }));
}

interface Props { campaign: Campaign }
const { campaign } = Astro.props;
const bodyHtml = await marked.parse(campaign.body);
const top = campaign.ranking?.[0];
const topProgram = top ? getProgram(top.programId) : getProgram(campaign.hero.primaryProgramId);
---
<LpLayout
  title={campaign.title}
  description={campaign.description}
  slug={campaign.slug}
  publishedAt={campaign.publishedAt}
  updatedAt={campaign.updatedAt}
  author={campaign.author}
  ogImage={campaign.seo?.ogImage}
>
  <HeroSection campaign={campaign} />

  {top && (
    <section class="mx-auto max-w-3xl px-4">
      <div class="rounded-2xl border-2 border-brand-600 bg-white p-5">
        <p class="text-sm font-bold text-brand-600">結論</p>
        <p class="mt-1 text-lg font-bold text-brand-900">迷ったら「{topProgram.name}」から。{top.catchcopy}。</p>
      </div>
    </section>
  )}

  {campaign.comparison && <ComparisonTable campaign={campaign} />}

  {campaign.ranking && campaign.ranking.length > 0 && (
    <section id="ranking" class="mx-auto max-w-3xl px-4 py-10">
      <h2 class="mb-6 text-2xl font-bold text-brand-900">おすすめランキング</h2>
      <div class="space-y-6">
        {campaign.ranking.map((r, i) => (
          <RankingCard rank={i + 1} programId={r.programId} catchcopy={r.catchcopy} reason={r.reason} recommendedFor={r.recommendedFor} campaign={campaign.slug} />
        ))}
      </div>
    </section>
  )}

  <article class="prose-lp mx-auto max-w-3xl px-4" set:html={bodyHtml} />

  <FaqSection items={campaign.faq ?? []} />

  <section class="mx-auto max-w-3xl px-4 py-10 text-center">
    <div class="rounded-2xl bg-brand-50 p-6">
      <p class="mb-4 font-bold text-brand-900">迷っているなら、まずは{topProgram.name}を試してみてください</p>
      <AffiliateButton programId={topProgram.id} label={campaign.hero.ctaLabel} microcopy={campaign.hero.microcopy} placement="final" campaign={campaign.slug} size="lg" />
    </div>
  </section>

  {campaign.compliance?.sources && campaign.compliance.sources.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-6 text-xs text-slate-500">
      <p class="font-bold">出典・参考</p>
      <ul class="list-disc pl-5">
        {campaign.compliance.sources.map((s) => <li><a class="underline" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
      </ul>
    </section>
  )}
</LpLayout>
