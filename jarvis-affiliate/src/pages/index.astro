---
import { loadCampaigns } from '../lib/campaigns.ts';
import '../styles/global.css';
const campaigns = loadCampaigns();
const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME ?? 'JARVIS比較ナビ';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME}</title>
    <meta name="description" content={`${SITE_NAME}の比較記事一覧`} />
  </head>
  <body>
    <div data-pr-label class="bg-amber-50 border-b border-amber-200 px-4 py-2 text-center text-xs text-amber-900">本ページはプロモーション（広告）を含みます</div>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <h1 class="mb-6 text-2xl font-bold text-brand-900">{SITE_NAME}</h1>
      <ul class="space-y-3">
        {campaigns.map((c) => (
          <li><a class="block rounded-xl p-4 ring-1 ring-slate-200 hover:bg-surface" href={`/lp/${c.slug}/`}><span class="font-bold text-brand-900">{c.title}</span><span class="block text-sm text-slate-500">{c.description}</span></a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
