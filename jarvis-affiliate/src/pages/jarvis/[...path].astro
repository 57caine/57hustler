---
/**
 * JARVIS コンソール（運用管理画面） /jarvis/
 * - LP・案件・SNS投稿案・改善提案・チェック結果を1画面で確認する
 * - データはビルド時に config/ content/ output/ から読み込む（npm run refresh で output/ を更新）
 * - 報酬単価などの内部情報を含むため、本番ビルド（JARVIS_ENV=production）では生成しない
 */
import fs from 'node:fs';
import path from 'node:path';
import { loadCampaigns, referencedProgramIds } from '../../lib/campaigns.ts';
import { loadAffiliates, ASP_RULES } from '../../lib/affiliates.ts';
import { p } from '../../lib/paths.ts';

export function getStaticPaths() {
  return process.env.JARVIS_ENV === 'production' ? [] : [{ params: { path: undefined } }];
}

// ---------- データ読み込み ----------
const readJson = <T,>(file: string): T | null => {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')) as T; } catch { return null; }
};
const latestIn = (dir: string, filter: (name: string) => boolean) => {
  if (!fs.existsSync(dir)) return null;
  const names = fs.readdirSync(dir).filter(filter).sort().reverse();
  return names[0] ? path.join(dir, names[0]) : null;
};

const campaigns = loadCampaigns({ includeDrafts: true });
const programs = loadAffiliates().programs;

type Issue = { level: 'error' | 'warn'; where: string; message: string };
const validation = readJson<{ generatedAt: string; mode: string; issues: Issue[] }>(p('output', 'validate-result.json'));
const errors = validation?.issues.filter((i) => i.level === 'error') ?? [];
const warns = validation?.issues.filter((i) => i.level === 'warn') ?? [];

type Metric = { slug: string; sessions: number; ctr: number | null; engagementRate: number | null; revenue: number; conversions: number; approved: number; findings: string[]; proposals: string[] };
const metricsFile = latestIn(p('output', 'reports'), (n) => /^metrics-.*\.json$/.test(n));
const metrics = metricsFile ? readJson<Metric[]>(metricsFile) ?? [] : [];
const metricsDate = metricsFile ? path.basename(metricsFile).replace(/^metrics-|\.json$/g, '') : null;
const usingSampleCsv = fs.existsSync(p('data', 'reports')) && fs.readdirSync(p('data', 'reports')).some((n) => n.startsWith('sample-'));

type Post = { id: string; platform: 'x' | 'threads'; pattern: string; angle?: string; text: string; length: number; limit: number };
const socialDir = latestIn(p('output', 'social'), (n) => /^\d{4}-\d{2}-\d{2}$/.test(n));
const socialDate = socialDir ? path.basename(socialDir) : null;
const posts: (Post & { campaign: string })[] = socialDir
  ? fs.readdirSync(socialDir).filter((n) => n.endsWith('.json')).flatMap((n) => {
      const j = readJson<{ campaign: string; posts: Post[] }>(path.join(socialDir, n));
      return (j?.posts ?? []).map((x) => ({ ...x, campaign: j!.campaign }));
    })
  : [];

// ---------- 表示用の整形 ----------
const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
const daysSince = (d?: string) => (d ? Math.floor((Date.parse(today) - Date.parse(d)) / 86400000) : null);
const pct = (n: number | null | undefined) => (n == null || !Number.isFinite(n) ? '—' : `${(n * 100).toFixed(1)}%`);
const yen = (n: number) => `${Math.round(n).toLocaleString('ja-JP')}円`;
const reward = (pr: (typeof programs)[number]) =>
  !pr.reward ? '—' : pr.reward.currency === 'PERCENT' ? `${pr.reward.amount}%` : `${pr.reward.amount.toLocaleString('ja-JP')}円`;
const patternLabel: Record<string, string> = { empathy: '共感', fact: '数字', 'benefit-list': 'メリット', question: '問いかけ', conclusion: '結論', trend: '時期ネタ' };
const patternText = (x: Post) => (x.pattern === 'trend' && x.angle ? `時期ネタ：${x.angle}` : patternLabel[x.pattern] ?? x.pattern);

const published = campaigns.filter((c) => c.status === 'published');
const drafts = campaigns.filter((c) => c.status === 'draft');
const dummies = programs.filter((x) => x.dummy);
const stale = programs.filter((x) => (daysSince(x.verifiedAt) ?? 999) > 30);
const totalRevenue = metrics.reduce((s, m) => s + (m.revenue ?? 0), 0);

// 今日の判断（オーナーが決めること）
type Decision = { tone: 'bad' | 'warn' | 'info'; title: string; detail: string; command: string };
const decisions: Decision[] = [];
if (!validation) decisions.push({ tone: 'warn', title: 'チェック結果がまだありません', detail: 'コマンドを実行すると、NGワード・リンク・PR表記の確認結果がここに出ます。', command: 'npm run refresh' });
if (errors.length) decisions.push({ tone: 'bad', title: `公開を止めるエラーが${errors.length}件あります`, detail: errors.slice(0, 2).map((e) => e.message).join(' ／ '), command: '/check-compliance' });
if (dummies.length) decisions.push({ tone: 'warn', title: `提携リンクが未設定の案件が${dummies.length}件`, detail: `${dummies.map((d) => d.name).join('、')}。ASPで発行したリンクを渡してもらえれば差し替えます。`, command: '/new-lp ここにASPのリンクを貼る' });
if (stale.length) decisions.push({ tone: 'warn', title: `料金の確認から30日を過ぎた案件が${stale.length}件`, detail: stale.map((x) => x.name).join('、'), command: '/check-compliance' });
for (const d of drafts) decisions.push({ tone: 'info', title: `下書きのLP：${d.title}`, detail: '公開するかどうかの判断待ちです。', command: `/new-lp ${d.slug} を公開する` });
for (const m of metrics) if (m.proposals?.[0]) decisions.push({ tone: 'info', title: `改善案を試すか：${m.slug}`, detail: m.proposals[0], command: '/daily-growth' });
if (posts.length) decisions.push({ tone: 'info', title: `SNS投稿案が${posts.length}件あります`, detail: '下の「SNS投稿案」から使うものを選んでコピーしてください。投稿は自動では行いません。', command: '/daily-growth' });

const toneLabel = { bad: '要対応', warn: '要確認', info: '判断待ち' };

const commands = [
  { cmd: '/new-lp', what: '新しいLPを作る（メモやASPリンクを続けて書く）' },
  { cmd: '/check-compliance', what: '全LPの法規制・リンク・計測をまとめて監査する' },
  { cmd: '/daily-growth', what: '数値確認・改善案・SNS投稿案をまとめて出す' },
  { cmd: 'npm run refresh', what: 'この画面のデータを最新にする（チェック・分析・投稿案）' },
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="claude:viewport-fit-sides" content="cover" />
  <title>JARVIS コンソール</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;500;700&display=swap" />
  <style is:global>
    /* 運用コンソール：上に状態の数字、次に「今日の判断」、その下に作業用の一覧を並べる */
    :root {
      --bg: #f4f6f9; --panel: #ffffff; --ink: #141a24; --muted: #5d6676; --line: #dfe4eb;
      --accent: #2a55c0; --accent-soft: #e8eefb;
      --good: #17784a; --good-soft: #e3f4ea; --warn: #9a5b00; --warn-soft: #fbf0dc; --bad: #b8322b; --bad-soft: #fbe6e4;
      --font-body: "IBM Plex Sans JP", "Hiragino Sans", "Yu Gothic", Meiryo, system-ui, sans-serif;
      --font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0f131a; --panel: #171c25; --ink: #e8ebf1; --muted: #9aa3b2; --line: #283041;
        --accent: #86a8ff; --accent-soft: #1d2840;
        --good: #57c992; --good-soft: #15291f; --warn: #f0b552; --warn-soft: #2d2414; --bad: #ff8278; --bad-soft: #321a19;
        color-scheme: dark;
      }
    }
    :root[data-theme="dark"] {
      --bg: #0f131a; --panel: #171c25; --ink: #e8ebf1; --muted: #9aa3b2; --line: #283041;
      --accent: #86a8ff; --accent-soft: #1d2840;
      --good: #57c992; --good-soft: #15291f; --warn: #f0b552; --warn-soft: #2d2414; --bad: #ff8278; --bad-soft: #321a19;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 15px; line-height: 1.7; }
    .wrap { max-width: 1180px; margin: 0 auto; padding-block: 24px 64px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); display: grid; gap: 28px; }
    h1, h2, h3 { margin: 0; text-wrap: balance; line-height: 1.35; }
    h2 { font-size: 17px; font-weight: 700; }
    .mono { font-family: var(--font-mono); }
    .num { font-variant-numeric: tabular-nums; }
    .muted { color: var(--muted); }
    a { color: var(--accent); }

    /* ヘッダー */
    .top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 16px; }
    .brand { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .brand h1 { font-family: var(--font-mono); font-size: 26px; font-weight: 500; letter-spacing: 0.06em; }
    .brand h1 b { color: var(--accent); font-weight: 500; }
    .meta { font-size: 13px; color: var(--muted); display: flex; gap: 14px; flex-wrap: wrap; }

    /* 状態の数字 */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    .stat { background: var(--panel); padding: 14px 16px; display: grid; gap: 2px; }
    .stat .label { font-size: 12px; color: var(--muted); letter-spacing: 0.04em; }
    .stat .value { font-family: var(--font-mono); font-size: 26px; font-weight: 500; }
    .stat .sub { font-size: 12px; color: var(--muted); }
    .stat.is-bad .value { color: var(--bad); }
    .stat.is-warn .value { color: var(--warn); }

    section { display: grid; gap: 12px; min-width: 0; align-content: start; }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .section-head p { margin: 0; font-size: 13px; color: var(--muted); }

    /* 今日の判断 */
    .queue { display: grid; gap: 8px; }
    .item { display: grid; grid-template-columns: auto 1fr auto; gap: 12px 16px; align-items: start; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .item > div { min-width: 0; }
    .item h3 { font-size: 15px; font-weight: 700; }
    .item p { margin: 2px 0 0; font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
    @media (max-width: 640px) { .item { grid-template-columns: 1fr; } }

    .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
    .chip::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .chip.bad { color: var(--bad); background: var(--bad-soft); }
    .chip.warn { color: var(--warn); background: var(--warn-soft); }
    .chip.info, .chip.accent { color: var(--accent); background: var(--accent-soft); }
    .chip.good { color: var(--good); background: var(--good-soft); }
    .chip.plain { color: var(--muted); background: transparent; border: 1px solid var(--line); }
    .chip.plain::before { display: none; }

    /* コピーボタン */
    .copy { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 7px; padding: 5px 10px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; max-width: 100%; text-align: left; }
    .copy span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .copy:hover { border-color: var(--accent); }
    .copy:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .copy[data-done] { color: var(--good); border-color: var(--good); }

    /* 表 */
    .table-box { overflow-x: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
    thead th { font-size: 12px; font-weight: 500; color: var(--muted); letter-spacing: 0.04em; white-space: nowrap; background: var(--panel); }
    tbody tr:last-child td, tbody tr:last-child th { border-bottom: 0; }
    td.r, th.r { text-align: right; }
    .title-cell { min-width: 220px; }
    .title-cell small { display: block; color: var(--muted); font-family: var(--font-mono); font-size: 12px; }

    .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
    @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }

    /* 投稿案 */
    .tabs { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .tabs button { font: inherit; font-size: 13px; padding: 4px 14px; border: 0; background: var(--panel); color: var(--muted); cursor: pointer; }
    .tabs button[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); font-weight: 500; }
    .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; }
    .post { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; display: grid; gap: 10px; align-content: start; min-width: 0; }
    .post-head { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .post pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--font-body); font-size: 13.5px; line-height: 1.65; }
    .post-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }

    /* 改善案・チェック結果 */
    .list { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 6px 14px; display: grid; align-content: start; }
    .list > div { padding: 10px 0; border-bottom: 1px solid var(--line); min-width: 0; }
    .list > div:last-child { border-bottom: 0; }
    .list ol, .list ul { margin: 6px 0 0; padding-left: 20px; font-size: 13.5px; }
    .list li + li { margin-top: 4px; }
    .issue { display: grid; grid-template-columns: auto 1fr; gap: 10px; font-size: 13px; align-items: start; }
    .issue code { font-family: var(--font-mono); font-size: 12px; color: var(--muted); display: block; overflow-wrap: anywhere; }

    .empty { background: var(--panel); border: 1px dashed var(--line); border-radius: 10px; padding: 18px; font-size: 13.5px; color: var(--muted); display: grid; gap: 8px; justify-items: start; }

    .cmds { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
    .cmd { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; display: grid; gap: 6px; justify-items: start; font-size: 13px; color: var(--muted); }
    .note { font-size: 12px; color: var(--muted); }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">
      <h1>JARVIS<b>/</b>AFFILIATE</h1>
      <span class="muted">運用コンソール</span>
    </div>
    <div class="meta num">
      <span>表示日 {today}</span>
      <span>チェック {validation ? validation.generatedAt.slice(0, 16).replace('T', ' ') : '未実行'}</span>
      <span>モード {validation?.mode ?? '—'}</span>
    </div>
  </header>

  <div class="stats" aria-label="現在の状態">
    <div class="stat"><span class="label">公開中のLP</span><span class="value num">{published.length}</span><span class="sub">下書き {drafts.length}</span></div>
    <div class:list={['stat', dummies.length && 'is-warn']}><span class="label">案件</span><span class="value num">{programs.length}</span><span class="sub">リンク未設定 {dummies.length}</span></div>
    <div class:list={['stat', errors.length && 'is-bad']}><span class="label">公開を止めるエラー</span><span class="value num">{validation ? errors.length : '—'}</span><span class="sub">警告 {warns.length}</span></div>
    <div class="stat"><span class="label">確定報酬（直近レポート）</span><span class="value num">{metrics.length ? yen(totalRevenue) : '—'}</span><span class="sub">{metricsDate ? `${metricsDate} 集計${usingSampleCsv ? '・サンプル含む' : ''}` : 'レポート未作成'}</span></div>
    <div class="stat"><span class="label">SNS投稿案</span><span class="value num">{posts.length}</span><span class="sub">{socialDate ? `${socialDate} 生成` : '未生成'}</span></div>
  </div>

  <section aria-labelledby="h-decisions">
    <div class="section-head">
      <h2 id="h-decisions">今日の判断</h2>
      <p>決めてほしいことだけを並べています。右のボタンでコマンドをコピーし、Claude Code に貼ってください。</p>
    </div>
    {decisions.length ? (
      <div class="queue">
        {decisions.map((d) => (
          <div class="item">
            <span class:list={['chip', d.tone]}>{toneLabel[d.tone]}</span>
            <div><h3>{d.title}</h3><p>{d.detail}</p></div>
            <button type="button" class="copy" data-copy={d.command} aria-label={`${d.command} をコピー`}><span>{d.command}</span></button>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty">判断待ちの項目はありません。</div>
    )}
  </section>

  <section aria-labelledby="h-lp">
    <div class="section-head">
      <h2 id="h-lp">LP一覧</h2>
      <p>数値は直近の分析レポートから。GA4のクリックはASPの成果ではありません。</p>
    </div>
    <div class="table-box">
      <table>
        <thead><tr><th>LP</th><th>状態</th><th class="r">案件</th><th class="r">セッション</th><th class="r">エンゲージ率</th><th class="r">クリック率</th><th class="r">発生 / 承認</th><th class="r">確定報酬</th><th>開く</th></tr></thead>
        <tbody>
          {campaigns.map((cp) => {
            const m = metrics.find((x) => x.slug === cp.slug);
            const hasDummy = referencedProgramIds(cp).some((id) => programs.find((x) => x.id === id)?.dummy);
            return (
              <tr>
                <td class="title-cell">{cp.title}<small>{cp.slug}</small></td>
                <td>
                  <span class:list={['chip', cp.status === 'published' ? 'good' : 'plain']}>{cp.status === 'published' ? '公開' : '下書き'}</span>
                  {hasDummy && <span class="chip warn" style="margin-left:4px">仮リンク</span>}
                </td>
                <td class="r num">{new Set(referencedProgramIds(cp)).size}</td>
                <td class="r num">{m ? m.sessions.toLocaleString('ja-JP') : '—'}</td>
                <td class="r num">{pct(m?.engagementRate)}</td>
                <td class="r num">{pct(m?.ctr)}</td>
                <td class="r num">{m ? `${m.conversions} / ${m.approved}` : '—'}</td>
                <td class="r num">{m ? yen(m.revenue) : '—'}</td>
                <td>{cp.status === 'published' ? <a href={`/lp/${cp.slug}/`}>LPを見る</a> : <span class="muted">未公開</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-programs">
    <div class="section-head">
      <h2 id="h-programs">案件マスター</h2>
      <p><span class="mono">config/affiliates.json</span> の内容です。料金の確認から30日を過ぎると警告になります。</p>
    </div>
    <div class="table-box">
      <table>
        <thead><tr><th>案件</th><th>ASP</th><th>リンク</th><th class="r">報酬</th><th>条件</th><th class="r">承認率</th><th class="r">確認日</th><th>使っているLP</th></tr></thead>
        <tbody>
          {programs.map((pr) => {
            const age = daysSince(pr.verifiedAt);
            const usedBy = campaigns.filter((cp) => referencedProgramIds(cp).includes(pr.id));
            return (
              <tr>
                <td class="title-cell">{pr.name}<small>{pr.id}</small></td>
                <td>{ASP_RULES[pr.asp]?.label ?? pr.asp}</td>
                <td>
                  {pr.status !== 'active' ? <span class="chip bad">{pr.status === 'paused' ? '停止中' : '審査中'}</span>
                    : pr.dummy ? <span class="chip warn">仮リンク</span> : <span class="chip good">提携済み</span>}
                </td>
                <td class="r num">{reward(pr)}</td>
                <td>{pr.reward?.condition ?? '—'}</td>
                <td class="r num">{pr.approvalRate != null ? pct(pr.approvalRate) : '—'}</td>
                <td class="r num">{pr.verifiedAt ?? '—'}{age != null && age > 30 && <span class="chip warn" style="margin-left:4px">{age}日前</span>}</td>
                <td>{usedBy.length ? usedBy.map((u) => u.slug).join(', ') : <span class="muted">未使用</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-posts">
    <div class="section-head">
      <h2 id="h-posts">SNS投稿案</h2>
      <div class="tabs" role="group" aria-label="表示するSNS">
        <button type="button" data-filter="all" aria-pressed="true">すべて</button>
        <button type="button" data-filter="x" aria-pressed="false">X</button>
        <button type="button" data-filter="threads" aria-pressed="false">Threads</button>
      </div>
    </div>
    {posts.length ? (
      <div class="posts">
        {posts.map((x) => (
          <article class="post" data-platform={x.platform}>
            <div class="post-head">
              <span class="chip accent">{x.platform === 'x' ? 'X' : 'Threads'}</span>
              <span class="chip plain">{patternText(x)}</span>
            </div>
            <pre>{x.text}</pre>
            <div class="post-foot">
              <span class="num">{x.length} / {x.limit}{x.platform === 'x' ? '（全角2換算）' : '字'}</span>
              <button type="button" class="copy" data-copy={x.text}><span>本文をコピー</span></button>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">投稿案はまだありません。<button type="button" class="copy" data-copy="npm run social"><span>npm run social</span></button></div>
    )}
    <p class="note">投稿は自動では行いません。リンク先は自分のLP（UTM付き）で、全案に #PR が入っています。</p>
  </section>

  <div class="two">
    <section aria-labelledby="h-lpo">
      <div class="section-head"><h2 id="h-lpo">改善提案</h2><p>{metricsDate ? `${metricsDate} のレポート` : ''}</p></div>
      {metrics.length ? (
        <div class="list">
          {metrics.map((m) => (
            <div>
              <strong>{campaigns.find((c) => c.slug === m.slug)?.title ?? m.slug}</strong>
              <ul class="muted">{m.findings.map((f) => <li>{f}</li>)}</ul>
              <ol>{m.proposals.slice(0, 4).map((x) => <li>{x}</li>)}</ol>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty">分析レポートがまだありません。GA4とASPのCSVを <span class="mono">data/reports/</span> に置いて実行します。<button type="button" class="copy" data-copy="npm run metrics"><span>npm run metrics</span></button></div>
      )}
      {usingSampleCsv && metrics.length > 0 && <p class="note">サンプルのCSV（ダミー）を含んだ集計です。実データを置いたら sample- ファイルは削除してください。</p>}
    </section>

    <section aria-labelledby="h-check">
      <div class="section-head"><h2 id="h-check">チェック結果</h2><p>NGワード・リンク直書き・PR表記・案件の整合性</p></div>
      {!validation ? (
        <div class="empty">まだ実行されていません。<button type="button" class="copy" data-copy="npm run refresh"><span>npm run refresh</span></button></div>
      ) : validation.issues.length ? (
        <div class="list">
          {[...errors, ...warns].map((i) => (
            <div class="issue">
              <span class:list={['chip', i.level === 'error' ? 'bad' : 'warn']}>{i.level === 'error' ? 'エラー' : '警告'}</span>
              <div>{i.message}<code>{i.where}</code></div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty">問題は見つかりませんでした。</div>
      )}
    </section>
  </div>

  <section aria-labelledby="h-cmd">
    <div class="section-head"><h2 id="h-cmd">コマンド</h2><p>Claude Code に貼るだけで動きます。</p></div>
    <div class="cmds">
      {commands.map((c) => (
        <div class="cmd"><button type="button" class="copy" data-copy={c.cmd}><span>{c.cmd}</span></button>{c.what}</div>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  // コピー（失敗時は文字列を選択状態にする）
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('[data-copy]');
    if (!btn) return;
    var text = btn.getAttribute('data-copy');
    var label = btn.querySelector('span');
    var original = label.textContent;
    function done(msg) { label.textContent = msg; btn.setAttribute('data-done', ''); setTimeout(function () { label.textContent = original; btn.removeAttribute('data-done'); }, 1400); }
    function fallback() { var r = document.createRange(); r.selectNodeContents(label); label.textContent = text; var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
    try { navigator.clipboard.writeText(text).then(function () { done('コピーしました'); }, fallback); } catch (err) { fallback(); }
  });
  // 投稿案の絞り込み
  document.querySelectorAll('[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.getAttribute('data-filter');
      document.querySelectorAll('[data-filter]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      document.querySelectorAll('.post').forEach(function (card) { card.hidden = f !== 'all' && card.getAttribute('data-platform') !== f; });
    });
  });
</script>
</body>
</html>
