---
/**
 * 全LP共通レイアウト
 * - PR表記バナー（ステマ規制対応。削除禁止）
 * - GA4 / GTM（.env の PUBLIC_GA4_ID / PUBLIC_GTM_ID があるときだけ出力）
 * - rel~="sponsored" リンクのクリックで GA4 イベント affiliate_click を送信
 * - OGP / canonical / 構造化データ（Article・BreadcrumbList・Organization）
 *   ※ schema.org/Product は出力しない（compliance-rules.md 5章）
 */
import '../styles/global.css';
import { PR_LABEL, PR_MARKER_ATTR } from '../lib/compliance.ts';

interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: string;
  updatedAt: string;
  author?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, slug, publishedAt, updatedAt, author, ogImage, noindex } = Astro.props;

const env = import.meta.env;
const GA4_ID: string = env.PUBLIC_GA4_ID && !String(env.PUBLIC_GA4_ID).includes('XXXX') ? env.PUBLIC_GA4_ID : '';
const GTM_ID: string = env.PUBLIC_GTM_ID ?? '';
const SITE_NAME: string = env.PUBLIC_SITE_NAME ?? 'JARVIS比較ナビ';
const OPERATOR: string = env.PUBLIC_OPERATOR_NAME ?? SITE_NAME;
const CONTACT: string = env.PUBLIC_CONTACT_URL ?? '';

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: publishedAt,
    dateModified: updatedAt,
    author: { '@type': 'Organization', name: author ?? OPERATOR },
    publisher: { '@type': 'Organization', name: SITE_NAME },
    mainEntityOfPage: canonical,
    ...(og ? { image: og } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL('/', Astro.site).toString(),
  },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta property="article:published_time" content={publishedAt} />
    <meta property="article:modified_time" content={updatedAt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {GTM_ID && (
      <script is:inline define:vars={{ GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',GTM_ID);
      </script>
    )}
    {GA4_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>}
    {GA4_ID && (
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', GA4_ID);
      </script>
    )}
  </head>
  <body data-ga4={GA4_ID ? 'on' : 'off'} data-campaign={slug}>
    {GTM_ID && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}

    <div {...{ [PR_MARKER_ATTR]: '' }} class="bg-amber-50 border-b border-amber-200 px-4 py-2 text-center text-xs text-amber-900 md:text-sm">
      {PR_LABEL}
    </div>

    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href="/" class="font-bold text-brand-900">{SITE_NAME}</a>
        <span class="text-xs text-slate-500">更新日：{updatedAt}</span>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 bg-brand-900 px-4 py-10 text-sm text-slate-300">
      <div class="mx-auto max-w-5xl space-y-2">
        <p>当サイトはアフィリエイトプログラムを利用しており、紹介したサービスの申込により運営者が報酬を受け取ることがあります。掲載順位・内容は編集部の判断に基づきます。</p>
        <p>運営者：{OPERATOR}{CONTACT && <> ／ <a class="underline" href={CONTACT}>お問い合わせ</a></>}</p>
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>

    <script is:inline>
      // rel="sponsored" のリンククリックを GA4 / GTM に送る（affiliate_click）
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[rel~="sponsored"]') : null;
        if (!a) return;
        var params = {
          affiliate_platform: a.dataset.affiliatePlatform || 'unknown',
          program_id: a.dataset.affiliateId || '',
          program_name: a.dataset.affiliateName || '',
          placement: a.dataset.placement || '',
          campaign: a.dataset.campaign || document.body.dataset.campaign || '',
          link_url: a.href,
          link_text: (a.textContent || '').trim().slice(0, 100),
          page_path: location.pathname,
          transport_type: 'beacon'
        };
        if (typeof window.gtag === 'function') window.gtag('event', 'affiliate_click', params);
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: 'affiliate_click' }, params));
      }, true);
    </script>
  </body>
</html>
